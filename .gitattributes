# Quarto emits trailing whitespace in bundled CSS/JS. Keep source checks strict
# without hand-editing generated output after every render.
docs/** whitespace=-blank-at-eol,-space-before-tab
# three.js shader source in the deck-3d bundle (and so in docs/index.html) keeps its
# own indentation: spaces before tabs, blanks at line ends.
assets/deck-3d.min.js whitespace=-blank-at-eol,-space-before-tab
# Preserve the published experiment's original bytes and provenance hash.
examples/marketing-context/hillstrom.csv -text whitespace=cr-at-eol
