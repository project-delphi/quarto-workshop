# Computed by scripts/evaluate.py: never committed
outputs/

# Python environment and caches (uv run rebuilds .venv/ from uv.lock)
.venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/

# The rendered website and Quarto's working files (Quarto adds the last two itself)
_site/
*.html
*.docx
*.pdf
*.pptx
!templates/*.docx
!templates/*.pptx
*_files/
/.quarto/
**/*.quarto_ipynb
