.env

# vscode
.vscode/

/.quarto/

# The Python template rule `dist/` above also matches docs/site_libs/revealjs/dist/,
# which is part of the published site. Keep the rendered output out of it.
!docs/site_libs/**

# Quarto intermediate notebook from executing {python} cells
*.quarto_ipynb

# Workshop examples and checkpoints are rendered locally for testing; keep only sources.
**/.quarto/
/examples/**/_site/
/examples/**/_freeze/
/examples/**/*_files/
/examples/**/*.html
/examples/**/*.docx
/examples/**/*.pdf
/examples/**/*.pptx
/examples/**/*.epub
/examples/**/*.ipynb
/examples/water/outputs/
/examples/water/data/raw/
/checkpoints/**/_site/
/checkpoints/**/_freeze/
/checkpoints/**/*_files/
/checkpoints/**/*.html
/checkpoints/**/*.docx
/checkpoints/**/*.pdf
/checkpoints/**/*.pptx
/checkpoints/**/*.epub
/checkpoints/**/*.ipynb
/checkpoints/**/outputs/
/checkpoints/**/data/raw/
# The evaluation project's exploratory notebook is a source file, not rendered output.
!/examples/eval/notebooks/*.ipynb
!/checkpoints/14-eval-start/notebooks/*.ipynb
!/checkpoints/15-eval-results/notebooks/*.ipynb
!/checkpoints/16-eval-slides/notebooks/*.ipynb
!/checkpoints/17-eval-site/notebooks/*.ipynb
!/checkpoints/18-eval-whitepaper/notebooks/*.ipynb
# Its PowerPoint and Word templates are source files too (scripts/make_reference_docs.py
# writes them; checkpoint 16's scripts/make_pptx_reference.py, the PowerPoint one).
!/examples/eval/templates/*.pptx
!/checkpoints/**/templates/*.pptx
!/examples/eval/templates/*.docx
!/checkpoints/**/templates/*.docx
/examples/eval/outputs/
# Book starters are copied out and rendered by readers; keep only sources.
/starters/**/.venv/
/starters/**/outputs/
/starters/**/_site/
/starters/**/_freeze/
/starters/**/*_files/
/starters/**/*.html
/starters/**/*.docx
/starters/**/*.pdf

# Build dependencies of the deck's three.js slides (assets/deck-3d/README.md).
/assets/deck-3d/node_modules/

**/*.quarto_ipynb
# Book edition (book/README.md): render output and media scratch files. book/_freeze/ is
# committed on purpose, so the EPUB rebuilds without re-executing the chapters.
/book/_book/
/book-es/_book/
# Copied from book/media by `make book-es-sync`: Quarto's resource globs do not follow symlinks.
/book-es/media/gifs/
/book-es/media/stills/
/book-es/media/capture/frames/
# docs/book/ while `make deck` renders the deck
/.book-keep/
/book/media/capture/frames/
/book/**/*_files/
/book-es/**/*_files/
/_ebook-check/
